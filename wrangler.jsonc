{
  "name": "smartphonesellout",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/admin",
      "/admin/*",
      "/sales-increment.html",
      "/sales-data-editor.html",
      "/studio/sales-estimator.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smartphone-sales",
      "database_id": "ed7d40d4-12bd-4231-ab14-4295480f4421",
      "migrations_dir": "migrations"
    }
  ]
}
